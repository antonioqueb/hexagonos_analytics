<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="hexagonos_analytics.Dashboard">
        <div t-if="state.authorized" class="hmx_analytics" t-att-aria-busy="state.loading ? 'true' : 'false'">
            <header class="hmx_hero" t-ref="header" t-on-keydown="onHeaderKeydown">
                <form t-if="state.options" class="hmx_header_form" t-on-submit.prevent="() => this.load()">
                    <div class="hmx_hero_top">
                        <div class="hmx_brand"><img src="/hexagonos_analytics/static/description/icon.svg" alt=""/>
                            <div><span class="hmx_eyebrow">Hexágonos Mexicanos</span><h1>Panel ejecutivo</h1></div>
                        </div>
                        <div class="hmx_header_actions">
                            <span t-attf-class="hmx_freshness #{state.pending ? 'pending' : ''} #{state.error ? 'failed' : ''}" role="status"
                                  t-att-title="state.updatedAt ? 'Última actualización: ' + state.updatedAt + ' · Monterrey' : 'Hora de Monterrey'">
                                <span class="hmx_status_dot" aria-hidden="true"/><t t-esc="updateLabel"/>
                            </span>
                            <button type="submit" class="hmx_primary" t-att-disabled="state.loading">
                                <svg t-if="!state.pending" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6.1 7a7 7 0 0 1 11.7-1L20 9M4 15l2.2 3A7 7 0 0 0 18 17"/></svg>
                                <t t-esc="state.pending ? 'Aplicar cambios' : 'Actualizar'"/>
                            </button>
                        </div>
                    </div>
                    <div class="hmx_filters">
                        <details class="hmx_dropdown hmx_period" t-on-toggle="onMenuToggle">
                            <summary class="hmx_field_control"><span class="hmx_field_label">Período</span><span class="hmx_field_value" t-esc="periodLabel"/></summary>
                            <div class="hmx_dropdown_body hmx_period_body"><div class="hmx_popover_heading"><h3>Período de consulta</h3><button type="button" class="hmx_close" aria-label="Cerrar período" t-on-click="() => this.closeHeaderMenus()">×</button></div>
                                <div class="hmx_presets" aria-label="Períodos rápidos"><button type="button" t-foreach="presets" t-as="preset" t-key="preset.key"
                                    t-att-class="selectedPreset === preset.key ? 'active' : ''" t-att-aria-pressed="selectedPreset === preset.key ? 'true' : 'false'"
                                    t-on-click="() => this.setPreset(preset.key)"><t t-esc="preset.label"/></button></div>
                                <div class="hmx_date_fields"><label>Desde<input type="date" name="date_from" required="required" t-att-value="state.filters.date_from" t-att-max="state.options.today" t-on-invalid="onInvalidField" t-on-change="ev => this.changeDate('date_from', ev)"/></label>
                                    <label>Hasta<input type="date" name="date_to" required="required" t-att-value="state.filters.date_to" t-att-min="state.filters.date_from" t-att-max="state.options.today" t-on-invalid="onInvalidField" t-on-change="ev => this.changeDate('date_to', ev)"/></label></div>
                                <p>Elige un acceso rápido o ajusta las fechas y pulsa Aplicar cambios.</p>
                            </div>
                        </details>
                        <label class="hmx_field_control hmx_comparison"><span class="hmx_field_label">Comparar con</span><select name="comparison" t-att-value="state.filters.comparison" t-on-change="ev => this.changeFilter('comparison', ev)">
                            <option value="previous_period" t-att-selected="state.filters.comparison === 'previous_period'">Período anterior</option><option value="previous_month" t-att-selected="state.filters.comparison === 'previous_month'">Mes anterior</option><option value="previous_year" t-att-selected="state.filters.comparison === 'previous_year'">Año anterior</option>
                        </select></label>
                        <label class="hmx_field_control hmx_currency"><span class="hmx_field_label">Divisa</span><select name="currency_id" t-att-value="state.filters.currency_id" t-on-change="changeCurrency" title="Mixto suma MXN y USD en pesos al promedio mensual del DOF. Una divisa conserva los importes originales.">
                            <option value="0" t-att-selected="state.filters.currency_id === 0">Mixto</option><option t-foreach="state.options.currencies" t-as="currency" t-key="currency.id" t-att-value="currency.id" t-att-selected="state.filters.currency_id === currency.id"><t t-esc="currency.name"/></option>
                        </select></label>
                        <details class="hmx_dropdown hmx_warehouses" t-on-toggle="onMenuToggle">
                            <summary class="hmx_field_control" t-att-title="warehouseLabel"><span class="hmx_field_label">Almacenes</span><span class="hmx_field_value" t-esc="warehouseLabel"/></summary>
                            <div class="hmx_dropdown_body"><div class="hmx_popover_heading"><h3>Almacenes</h3><button type="button" class="hmx_close" aria-label="Cerrar almacenes" t-on-click="() => this.closeHeaderMenus()">×</button></div>
                                <p>Venta: almacén comercial. Producción: fabricación. Entrega: despacho.</p>
                                <label><input type="checkbox" t-att-checked="state.filters.warehouse_ids.includes(0)" t-on-change="ev => this.toggleWarehouse(0, ev.target.checked)"/> Sin asignar</label>
                                <label t-foreach="state.options.warehouses" t-as="warehouse" t-key="warehouse.id"><input type="checkbox" t-att-checked="state.filters.warehouse_ids.includes(warehouse.id)" t-on-change="ev => this.toggleWarehouse(warehouse.id, ev.target.checked)"/><t t-esc="warehouse.name"/></label>
                                <p>Sin selección se consulta el consolidado, incluido Sin asignar.</p>
                            </div>
                        </details>
                        <details class="hmx_dropdown hmx_more" t-on-toggle="onMenuToggle">
                            <summary class="hmx_more_trigger" aria-label="Filtros adicionales"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="2" fill="white"/><circle cx="15" cy="17" r="2" fill="white"/></svg>Filtros<span t-if="filterCount" class="hmx_filter_count" t-esc="filterCount"/></summary>
                            <div class="hmx_dropdown_body"><div class="hmx_popover_heading"><h3>Filtros adicionales</h3><button type="button" class="hmx_close" aria-label="Cerrar filtros" t-on-click="() => this.closeHeaderMenus()">×</button></div>
                                <div t-foreach="filterCatalogs" t-as="catalog" t-key="catalog.key" class="hmx_catalog"><label><t t-esc="catalog.label"/>
                                    <input type="search" placeholder="Buscar…" t-att-aria-label="'Buscar ' + catalog.label" t-on-change="ev => this.searchCatalog(catalog.key, ev.target.value)"/>
                                    <select t-att-value="state.filters[catalog.key + '_id']" t-on-change="ev => this.changeFilter(catalog.key + '_id', ev)"><option value="0" t-att-selected="!state.filters[catalog.key + '_id']">Todos</option><option t-foreach="state.options[catalog.key + 's']" t-as="option" t-key="option.id" t-att-value="option.id" t-att-selected="state.filters[catalog.key + '_id'] === option.id"><t t-esc="option.name"/></option></select>
                                </label></div>
                                <p>Hasta 50 coincidencias. Los filtros de cliente y vendedor aplican al análisis comercial.</p>
                                <div class="hmx_popover_heading"><h3>Seguimiento de clientes</h3></div>
                                <label>Inactividad mínima (días)<input type="number" min="7" max="730" t-att-value="state.filters.inactivity_days" t-on-invalid="onInvalidField" t-on-change="ev => this.changeFilter('inactivity_days', ev)"/></label>
                                <label>Multiplicador de frecuencia<input type="number" min="1" max="6" step="0.5" t-att-value="state.filters.cadence_factor" t-on-invalid="onInvalidField" t-on-change="ev => this.changeFilter('cadence_factor', ev)"/></label>
                            </div>
                        </details>
                    </div>
                    <div t-if="activeFilters.length" class="hmx_chips" aria-label="Filtros activos"><span class="hmx_chips_label" t-esc="state.pending ? 'Por aplicar' : 'Filtros activos'"/>
                        <button type="button" class="hmx_filter_chip" t-foreach="activeFilters" t-as="chip" t-key="chip.key" t-att-title="chip.label" t-att-aria-label="'Quitar ' + chip.label" t-on-click="() => this.removeFilter(chip)"><span t-esc="chip.label"/><span aria-hidden="true">×</span></button>
                        <button type="button" class="hmx_clear" t-on-click="clearFilters">Restablecer filtros</button>
                    </div>
                </form>
                <nav t-if="state.options" class="hmx_navigation" aria-label="Vistas del negocio">
                    <div class="hmx_tabs"><button t-foreach="primaryTabs" t-as="tab" t-key="tab.key" t-att-class="state.tab === tab.key ? 'active' : ''" t-att-aria-label="tab.label" t-att-aria-current="state.tab === tab.key ? 'page' : undefined" t-on-click="() => this.load(tab.key)"><t t-esc="tab.shortLabel"/></button></div>
                    <div class="hmx_nav_groups"><details t-foreach="navigationGroups" t-as="group" t-key="group.key" t-attf-class="hmx_dropdown hmx_nav_group #{group.active ? 'active' : ''}" t-on-toggle="onMenuToggle">
                        <summary><t t-esc="group.label"/><span t-if="group.active" class="hmx_current_view"> · <t t-esc="group.active.label"/></span></summary>
                        <div class="hmx_dropdown_body hmx_nav_menu"><button t-foreach="group.tabs" t-as="tab" t-key="tab.key" t-att-class="state.tab === tab.key ? 'active' : ''" t-att-aria-current="state.tab === tab.key ? 'page' : undefined" t-on-click="() => this.load(tab.key)"><t t-esc="tab.label"/><span t-if="state.tab === tab.key" aria-hidden="true">✓</span></button></div>
                    </details></div>
                    <label class="hmx_mobile_nav">Vista<select aria-label="Vista del negocio" t-att-value="state.tab" t-on-change="ev => this.load(ev.target.value)">
                        <optgroup label="Negocio"><option t-foreach="primaryTabs" t-as="tab" t-key="tab.key" t-att-value="tab.key" t-att-selected="state.tab === tab.key"><t t-esc="tab.label"/></option></optgroup>
                        <optgroup t-foreach="navigationGroups" t-as="group" t-key="group.key" t-att-label="group.label"><option t-foreach="group.tabs" t-as="tab" t-key="tab.key" t-att-value="tab.key" t-att-selected="state.tab === tab.key"><t t-esc="tab.label"/></option></optgroup>
                    </select></label>
                </nav>
            </header>

            <main class="hmx_body">
                <div class="hmx_context">
                    <i class="fa fa-info-circle" aria-hidden="true"/>
                    <span>Los resultados del período se separan de los pendientes y existencias actuales.
                        Solo se incluyen registros visibles de la compañía activa. Cliente y vendedor no filtran producción.</span>
                </div>
                <div t-if="state.error" class="alert alert-danger" role="alert"><t t-esc="state.error"/></div>
                <div t-if="state.loading" class="hmx_loading" role="status">
                    <i class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/> Consultando la operación…
                </div>
                <div t-if="!state.loading and !state.data and !state.error" class="hmx_empty">Pulsa Aplicar cambios para consultar la selección.</div>
                <section t-if="state.data and state.data.fx" class="hmx_fx" aria-label="Conversión con promedio mensual DOF">
                    <t t-if="state.data.fx.applied">
                        <div class="hmx_section_heading"><div><strong>Consolidado en MXN · promedio mensual DOF</strong><p>Pesos + dólares convertidos al promedio de su mes. Los documentos conservan su moneda original.</p></div>
                            <span class="hmx_scope">MXN + USD</span></div>
                        <div class="hmx_fx_rates"><span t-foreach="state.data.fx.rates.filter(rate => rate.selected)" t-as="rate" t-key="rate.month"><b t-esc="rate.month"/> · <t t-if="rate.available">1 USD = <b t-esc="fxNumber(rate.average)"/> MXN <t t-if="rate.provisional">· provisional</t></t><t t-else="">promedio no disponible</t></span></div>
                        <p t-if="state.data.fx.excluded and state.data.fx.excluded.length" class="hmx_notice">Divisas fuera del consolidado: <t t-esc="state.data.fx.excluded.join(', ')"/>. Puedes consultarlas en el selector de divisa.</p>
                        <details class="hmx_fx_detail"><summary>Ver promedios, publicaciones y fórmula</summary><p t-esc="state.data.fx.formula"/><p t-esc="state.data.fx.method"/>
                            <div class="hmx_table_scroll"><table class="hmx_table"><thead><tr><th>Mes</th><th>MXN por USD</th><th>Publicaciones</th><th>Última publicación</th><th>Estado</th><th>Consultado (UTC)</th><th>Fuente y valores</th></tr></thead><tbody>
                                <tr t-foreach="state.data.fx.rates" t-as="rate" t-key="rate.month"><th scope="row" t-esc="rate.month"/><td t-esc="rate.available ? fxNumber(rate.average) : 'No disponible'"/><td t-esc="rate.count"/><td t-esc="rate.last_publication || '—'"/><td t-esc="rate.provisional ? 'Provisional' : 'Mes cerrado'"/><td t-esc="rate.fetched_at"/>
                                    <td><a t-att-href="rate.public_url" target="_blank" rel="noopener noreferrer">Ver DOF ↗</a><details t-if="rate.publications.length"><summary>Valores diarios</summary><ul class="hmx_fx_publications"><li t-foreach="rate.publications" t-as="publication" t-key="publication.date"><t t-esc="publication.date"/> · <t t-esc="publication.value"/></li></ul></details><span t-else="" t-esc="rate.error"/></td>
                                </tr>
                            </tbody></table></div>
                        </details>
                    </t>
                    <p t-else="" role="status"><strong>No se pudo consolidar con el DOF.</strong> <t t-esc="state.data.fx.error"/> Los importes se muestran por divisa, sin sumarlos.</p>
                </section>
                <t t-if="state.data and state.data.executive">
                    <t t-set="viewData" t-value="state.data"/><t t-call="hexagonos_analytics.Executive"/>
                </t>
                <t t-if="state.data and !state.data.executive">
                    <p class="hmx_context" t-if="state.data.scope_note" t-esc="state.data.scope_note"/>
                    <div class="hmx_section_heading">
                        <div><h2><t t-esc="state.options.tabs.find(t => t.key === state.tab).label"/></h2>
                            <p><t t-esc="state.data.company"/> · <t t-esc="state.data.period"/></p>
                        </div>
                        <span t-if="state.detailLoading" role="status">Cargando detalle…</span>
                        <span t-else="">Selecciona un indicador para revisar su cálculo y sus registros.</span>
                    </div>
                    <div class="hmx_metrics">
                        <button t-foreach="state.data.metrics" t-as="metric" t-key="metric.key"
                                t-attf-class="hmx_metric #{metric.tone} #{!metric.available ? 'unavailable' : ''}"
                                t-att-disabled="!metric.available or state.detailLoading"
                                t-att-title="metric.definition" t-on-click="() => this.showDetail(metric)">
                            <span t-attf-class="hmx_scope #{metric.scope}"><t t-esc="scopeLabel(metric.scope)"/></span>
                            <span class="hmx_metric_label"><t t-esc="metric.label"/></span>
                            <strong t-if="metric.available"><t t-esc="number(metric.value)"/><small t-if="metric.value !== null and metric.unit"> <t t-esc="metric.unit"/></small></strong>
                            <strong t-else="" class="hmx_restricted">Sin acceso</strong>
                            <span t-if="metric.sample !== null" class="hmx_metric_hint"><t t-esc="metric.numerator"/> de <t t-esc="metric.sample"/> registros evaluables</span>
                            <span t-elif="!metric.available" class="hmx_metric_hint"><t t-esc="metric.reason"/></span>
                            <span t-else="" class="hmx_metric_hint">Ver definición y registros <span aria-hidden="true">↗</span></span>
                        </button>
                    </div>
                    <div class="hmx_panels">
                        <AnalyticsChart t-foreach="operationalCharts" t-as="chart" t-key="chart.key" spec="chart" openAction.bind="openAction"/>
                    </div>
                    <aside class="hmx_method">
                        <strong>Lectura de dirección</strong>
                        <p>Una cifra en cero significa que no hay registros visibles que cumplan el criterio. “Sin base” indica que no existen registros evaluables para calcular el porcentaje.</p>
                        <p>Las plantas de Calidad y Compras son clasificaciones propias; los almacenes de Ventas y los tipos de operación de Producción conservan su significado. No se igualan automáticamente con las plantas de Asistencia.</p>
                        <p>Las vistas ejecutivas separan ventas, facturación y cobros registrados. No se calcula utilidad, OEE ni OTIF sin bases verificadas.</p>
                    </aside>
                </t>
            </main>
        </div>
    </t>

    <t t-name="hexagonos_analytics.Detail">
        <Dialog title="props.detail.metric.label" size="'lg'">
            <div class="hmx_detail">
                <span class="hmx_scope"><t t-esc="props.detail.metric.scope === 'periodo' ? 'Período seleccionado' : 'Situación actual'"/></span>
                <h3 class="mt-3"><t t-esc="number(props.detail.metric.value)"/><t t-if="props.detail.metric.value !== null"> <t t-esc="props.detail.metric.unit"/></t></h3>
                <p t-if="props.detail.metric.sample !== null"><t t-esc="props.detail.metric.numerator"/> de <t t-esc="props.detail.metric.sample"/> registros evaluables.</p>
                <p><t t-esc="props.detail.metric.definition"/></p>
                <p class="text-muted"><t t-esc="props.detail.detail_note"/> Vista previa de hasta 20 registros, ordenados por fecha ascendente. Total: <t t-esc="props.detail.total"/>.</p>
                <div class="table-responsive"><table class="table table-hover">
                    <thead><tr><th>Registro</th><th><t t-esc="props.detail.date_label"/></th><th>Estado</th></tr></thead>
                    <tbody><tr t-foreach="props.detail.rows" t-as="row" t-key="row.id">
                        <td><button class="btn btn-link p-0 text-start" t-on-click="() => { props.openRecord(row.id); props.close(); }"><t t-esc="row.name"/></button></td>
                        <td><t t-esc="row.date"/></td><td><t t-esc="row.state"/></td>
                    </tr><tr t-if="!props.detail.rows.length"><td colspan="3" class="text-muted">Sin registros para este alcance.</td></tr></tbody>
                </table></div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="() => { props.openAction(props.detail.action); props.close(); }">Abrir todos los registros</button>
                <button class="btn btn-secondary" t-on-click="props.close">Cerrar</button>
            </t>
        </Dialog>
    </t>
</templates>
